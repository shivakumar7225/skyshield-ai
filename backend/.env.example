# ==============================================================================
# SKYSHIELD AI — Backend Environment Configuration Template
# Problem Statement 26077 (Smart India Hackathon) — Ministry of Earth Sciences
# ==============================================================================

# Application Environment: DEVELOPMENT | DEMO | LIVE
APP_ENV=DEVELOPMENT
DEMO_MODE=true

# Database (PostgreSQL + PostGIS in production, SQLite supported for lightweight local tests)
# Example PostgreSQL PostGIS: postgresql+psycopg2://postgres:postgres@localhost:5432/skyshield_db
DATABASE_URL=sqlite:///./skyshield.db

# Redis Cache & Message Broker (Optional, in-memory fallback enabled if absent)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=skyshield_secure_production_secret_key_change_in_production_928374
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# External Weather Providers
OPEN_METEO_ENABLED=true
OPENWEATHER_API_KEY=

# Google Maps Platform (Maps JavaScript, Places, Geocoding, Routes)
GOOGLE_MAPS_API_KEY=

# MOSDAC (Meteorological and Oceanographic Satellite Data Archival Centre)
# INSAT-3D / INSAT-3DR Real-Time/Archival Access Credentials
MOSDAC_API_KEY=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_BASE_URL=https://mosdac.gov.in/api

# IMDAA (Indian Monsoon Data Assimilation and Analysis) Reanalysis Access
IMDAA_DATA_DIR=./data/imdaa
IMDAA_API_ENDPOINT=

# QPE (Quantitative Precipitation Estimation) & Radar Data
QPE_DATA_DIR=./data/qpe

# DEM (Digital Elevation Model - CartoDEM / SRTM)
DEM_DATA_DIR=./data/dem

# Google Gemini AI Explanation API
GEMINI_API_KEY=

# Real-Time Update Cadence (Seconds)
WEATHER_UPDATE_INTERVAL_SECONDS=300
PREDICTION_UPDATE_INTERVAL_SECONDS=120
